{
  "productName": "NoadYT-Desktop",
  "version": "0.1.0",
  "identifier": "com.noadyt.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:37345",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NoadYT-Desktop",
        "width": 1500,
        "height": 1000,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "resources": ["icons/icon.ico", "resources/python/**/*", "resources/ffmpeg/**/*"]
  }
}
