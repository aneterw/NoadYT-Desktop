{
  "productName": "NoadYT-Desktop",
  "version": "0.5.0",
  "identifier": "com.noadyt.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:37345",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NoadYT-Desktop",
        "width": 1500,
        "height": 1000,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Main application capability",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:default",
            "core:app:default",
            "core:event:default",
            "core:webview:default",
            "core:path:default"
          ]
        },
        {
          "identifier": "capability-libmpv",
          "description": "Allow libmpv plugin commands",
          "windows": ["main"],
          "permissions": ["libmpv:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "resources": ["icons/icon.ico", "resources/python/**/*", "resources/ffmpeg/**/*", "lib/**/*"]
  }
}
